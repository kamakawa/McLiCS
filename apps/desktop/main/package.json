{
  "name": "mclist-desktop",
  "version": "1.1.0",
  "main": "main.js",
  "type": "commonjs",
  "author": {
    "name": "Eric Kamakawa",
    "email": "erickamakawa@hotmail.com"
  },
  "homepage": "https://github.com/erickamakawa/MClist",
  "description": "MClist",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",

    "build:renderer": "npm --prefix ../renderer run build",

    "prepare:packaged-assets": "node ./scripts/prepare-packaged-assets.js",

    "dist:linux": "npm run build:renderer && npm run prepare:packaged-assets && electron-builder --linux AppImage deb",
    "dist:dir": "npm run build:renderer && npm run prepare:packaged-assets && electron-builder --dir",

    "pack": "npm run dist:linux"
  },

  "dependencies": {
    "pdfkit": "^0.17.2"
  },

  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.mclist.desktop",
    "productName": "MClist",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],

    "extraResources": [
      {
        "from": "resources/renderer-dist",
        "to": "renderer-dist",
        "filter": ["**/*"]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "resources/scripts",
        "to": "scripts",
        "filter": ["**/*"]
      }
    ],

    "asar": true,

    "asarUnpack": [
      "backend/**/*",
      "scripts/**/*"
    ],

    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "icon": "build",
      "maintainer": "Eric Kamakawa <erickamakawa@gmail.com>",
      "artifactName": "MClist-${version}-${arch}.${ext}"
    }
  }
}